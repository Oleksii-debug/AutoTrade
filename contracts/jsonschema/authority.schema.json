{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autotrade.local/3.0.0/authority.schema.json",
  "title": "AutoTrade risk and authority contracts",
  "$defs": {
    "AuthorityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "version",
        "mode",
        "account_scope",
        "environments",
        "allowed_assets",
        "allowed_actions",
        "capital_bounds",
        "risk_policy_id",
        "model_allowlist",
        "compute_budget",
        "protective_action_policy",
        "valid_from",
        "revocation_epoch",
        "actor_id"
      ],
      "properties": {
        "policy_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/Sequence"
        },
        "mode": {
          "enum": [
            "CONFIRMATION",
            "AUTONOMOUS"
          ]
        },
        "account_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/Environment"
          }
        },
        "allowed_assets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capital_bounds": {
          "type": "object"
        },
        "risk_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "model_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compute_budget": {
          "$ref": "common.schema.json#/$defs/Money"
        },
        "protective_action_policy": {
          "type": "object"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/UtcInstant"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/UtcInstant"
        },
        "revocation_epoch": {
          "$ref": "common.schema.json#/$defs/Sequence"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmation_id",
        "actor_id",
        "intent_hash",
        "account_id",
        "environment",
        "max_quantity",
        "max_total_cost",
        "policy_version",
        "expires_at"
      ],
      "properties": {
        "confirmation_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "intent_hash": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "$ref": "common.schema.json#/$defs/Environment"
        },
        "max_quantity": {
          "$ref": "common.schema.json#/$defs/Quantity"
        },
        "max_total_cost": {
          "$ref": "common.schema.json#/$defs/Money"
        },
        "policy_version": {
          "$ref": "common.schema.json#/$defs/Sequence"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/UtcInstant"
        },
        "consumed_at": {
          "$ref": "common.schema.json#/$defs/UtcInstant"
        }
      }
    },
    "RiskDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "intent_hash",
        "state_version",
        "policy_version",
        "capability_snapshot_id",
        "evaluated_at",
        "valid_until",
        "verdict",
        "checks",
        "reservation_delta",
        "reason_codes"
      ],
      "properties": {
        "decision_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "intent_hash": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "state_version": {
          "$ref": "common.schema.json#/$defs/Sequence"
        },
        "policy_version": {
          "$ref": "common.schema.json#/$defs/Sequence"
        },
        "capability_snapshot_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "evaluated_at": {
          "$ref": "common.schema.json#/$defs/UtcInstant"
        },
        "valid_until": {
          "$ref": "common.schema.json#/$defs/UtcInstant"
        },
        "verdict": {
          "enum": [
            "ALLOW",
            "REJECT",
            "REQUIRE_REVIEW"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reservation_delta": {
          "type": "object"
        },
        "stress_result_ref": {
          "$ref": "common.schema.json#/$defs/EvidenceRef"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "AdmissionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_id",
        "intent_hash",
        "risk_decision_id",
        "authority_ref",
        "reservation_id",
        "owner_epoch",
        "policy_revocation_epoch",
        "expires_at",
        "status"
      ],
      "properties": {
        "admission_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "intent_hash": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "risk_decision_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "reservation_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "owner_epoch": {
          "$ref": "common.schema.json#/$defs/Sequence"
        },
        "policy_revocation_epoch": {
          "$ref": "common.schema.json#/$defs/Sequence"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/UtcInstant"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "CONSUMED",
            "EXPIRED",
            "REVOKED",
            "REJECTED"
          ]
        }
      }
    }
  }
}
