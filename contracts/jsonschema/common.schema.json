{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autotrade.local/3.0.0/common.schema.json",
  "title": "AutoTrade common contract types",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "UtcInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "Decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]|-(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]))$"
    },
    "CurrencyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "UnitId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "Environment": {
      "enum": [
        "REPLAY",
        "SIMULATION",
        "PAPER",
        "LIVE"
      ]
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/Decimal"
        },
        "currency": {
          "$ref": "#/$defs/CurrencyId"
        }
      }
    },
    "Quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "unit": {
          "$ref": "#/$defs/UnitId"
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "observed_at"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "observed_at": {
          "$ref": "#/$defs/UtcInstant"
        },
        "rights_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
