{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.autotrade.local/3.0.0/decision.schema.json",
  "title":"AutoTrade decision and portfolio contracts",
  "$defs":{
    "DecisionProposal":{
      "type":"object","additionalProperties":false,
      "required":["proposal_id","strategy_version","decision_at","information_cutoff","input_manifest_refs","thesis","candidate_instruments","horizon","expected_return_distribution_ref","confidence_basis","counterarguments","exit_policy_ref","expiry","estimated_compute_cost"],
      "properties":{
        "proposal_id":{"$ref":"common.schema.json#/$defs/Id"},
        "strategy_version":{"type":"string","minLength":1},
        "model_version":{"type":"string","minLength":1},
        "decision_at":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "information_cutoff":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "input_manifest_refs":{"type":"array","items":{"$ref":"common.schema.json#/$defs/Digest"}},
        "thesis":{"type":"string","minLength":1},
        "candidate_instruments":{"type":"array","items":{"type":"string","minLength":1}},
        "horizon":{"type":"string","minLength":1},
        "expected_return_distribution_ref":{"type":"string","minLength":1},
        "confidence_basis":{"type":"object"},
        "counterarguments":{"type":"array","items":{"type":"string","minLength":1}},
        "exit_policy_ref":{"type":"string","minLength":1},
        "expiry":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "estimated_compute_cost":{"$ref":"common.schema.json#/$defs/Money"},
        "NO_TRADE_reason":{"type":"string","minLength":1}
      }
    },
    "TargetExposure":{
      "type":"object","additionalProperties":false,
      "required":["instrument_version","quantity"],
      "properties":{
        "instrument_version":{"type":"string","minLength":1},
        "quantity":{"$ref":"common.schema.json#/$defs/Quantity"}
      }
    },
    "PortfolioTarget":{
      "type":"object","additionalProperties":false,
      "required":["target_id","account_scope","base_currency","as_of_state_version","target_exposures","cash_reserve","constraint_set_id","objective_version","proposal_refs","turnover_limit","estimated_costs","solver_status"],
      "properties":{
        "target_id":{"$ref":"common.schema.json#/$defs/Id"},
        "account_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "base_currency":{"$ref":"common.schema.json#/$defs/CurrencyId"},
        "as_of_state_version":{"$ref":"common.schema.json#/$defs/Sequence"},
        "target_exposures":{"type":"array","items":{"$ref":"#/$defs/TargetExposure"}},
        "cash_reserve":{"$ref":"common.schema.json#/$defs/Money"},
        "constraint_set_id":{"type":"string","minLength":1},
        "objective_version":{"type":"string","minLength":1},
        "proposal_refs":{"type":"array","items":{"type":"string","minLength":1}},
        "turnover_limit":{"$ref":"common.schema.json#/$defs/Decimal"},
        "estimated_costs":{"$ref":"common.schema.json#/$defs/Money"},
        "solver_status":{"enum":["OPTIMAL","FEASIBLE","INFEASIBLE","FAILED","TIMEOUT","NO_INCREASE"]},
        "fallback_reason":{"type":"string","minLength":1}
      }
    }
  }
}
