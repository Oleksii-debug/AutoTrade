{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.autotrade.local/3.0.0/learning.schema.json",
  "title":"AutoTrade learning, science and job contracts",
  "$defs":{
    "ExperienceEpisode":{
      "type":"object","additionalProperties":false,
      "required":["episode_id","revision","information_cutoff","input_hashes","strategy_version","intended_action","observed_execution","realized_outcome_window","cost_attribution","uncertainty","regime_tags","failure_tags","evidence"],
      "properties":{
        "episode_id":{"$ref":"common.schema.json#/$defs/Id"},
        "revision":{"$ref":"common.schema.json#/$defs/Sequence"},
        "proposal_ref":{"type":"string","minLength":1},
        "intent_ref":{"type":"string","minLength":1},
        "information_cutoff":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "input_hashes":{"type":"array","items":{"$ref":"common.schema.json#/$defs/Digest"}},
        "model_version":{"type":"string","minLength":1},
        "strategy_version":{"type":"string","minLength":1},
        "intended_action":{"type":"object"},
        "observed_execution":{"type":"object"},
        "realized_outcome_window":{"type":"object"},
        "cost_attribution":{"type":"object"},
        "counterfactual_policy":{"type":"object"},
        "uncertainty":{"type":"object"},
        "regime_tags":{"type":"array","items":{"type":"string","minLength":1}},
        "failure_tags":{"type":"array","items":{"type":"string","minLength":1}},
        "evidence":{"type":"array","items":{"$ref":"common.schema.json#/$defs/EvidenceRef"}}
      }
    },
    "ModelArtifact":{
      "type":"object","additionalProperties":false,
      "required":["artifact_digest","format","feature_schema","training_data_hashes","training_cutoffs","algorithm_version","seeds","environment_lock","license","risk_classification","inference_resource_profile"],
      "properties":{
        "artifact_digest":{"$ref":"common.schema.json#/$defs/Digest"},
        "format":{"type":"string","minLength":1},
        "feature_schema":{"type":"string","minLength":1},
        "training_data_hashes":{"type":"array","items":{"$ref":"common.schema.json#/$defs/Digest"}},
        "training_cutoffs":{"type":"object"},
        "algorithm_version":{"type":"string","minLength":1},
        "seeds":{"type":"array","items":{"type":"integer"}},
        "environment_lock":{"type":"object"},
        "license":{"type":"string","minLength":1},
        "risk_classification":{"type":"string","minLength":1},
        "inference_resource_profile":{"type":"object"}
      }
    },
    "ExperimentProtocol":{
      "type":"object","additionalProperties":false,
      "required":["protocol_id","digest","hypothesis","train_window","validation_window","test_window","forward_window","purge_embargo_rule","comparison_baselines","trial_budget","metric_directions","acceptance_thresholds","cost_model","stopping_rule","holdout_access_policy"],
      "properties":{
        "protocol_id":{"$ref":"common.schema.json#/$defs/Id"},
        "digest":{"$ref":"common.schema.json#/$defs/Digest"},
        "hypothesis":{"type":"string","minLength":1},
        "train_window":{"type":"object"},
        "validation_window":{"type":"object"},
        "test_window":{"type":"object"},
        "forward_window":{"type":"object"},
        "purge_embargo_rule":{"type":"object"},
        "comparison_baselines":{"type":"array","items":{"type":"string","minLength":1}},
        "trial_budget":{"type":"integer","minimum":1},
        "metric_directions":{"type":"object"},
        "acceptance_thresholds":{"type":"object"},
        "cost_model":{"type":"object"},
        "stopping_rule":{"type":"object"},
        "holdout_access_policy":{"type":"object"}
      }
    },
    "EvaluationResult":{
      "type":"object","additionalProperties":false,
      "required":["result_id","protocol_digest","run_hashes","metrics","failed_checks","selection_accounting","retention_regression","cost","latency","verdict"],
      "properties":{
        "result_id":{"$ref":"common.schema.json#/$defs/Id"},
        "protocol_digest":{"$ref":"common.schema.json#/$defs/Digest"},
        "run_hashes":{"type":"array","items":{"$ref":"common.schema.json#/$defs/Digest"}},
        "metrics":{"type":"object"},
        "failed_checks":{"type":"array","items":{"type":"string","minLength":1}},
        "selection_accounting":{"type":"object"},
        "retention_regression":{"type":"object"},
        "cost":{"$ref":"common.schema.json#/$defs/Money"},
        "latency":{"type":"object"},
        "verdict":{"enum":["PASS","FAIL","INCONCLUSIVE"]}
      }
    },
    "PromotionDecision":{
      "type":"object","additionalProperties":false,
      "required":["promotion_id","candidate_version","prior_version","result_refs","scope","envelope","independent_gate_signer","effective_version","rollback_target","verdict"],
      "properties":{
        "promotion_id":{"$ref":"common.schema.json#/$defs/Id"},
        "candidate_version":{"type":"string","minLength":1},
        "prior_version":{"type":"string","minLength":1},
        "result_refs":{"type":"array","items":{"type":"string","minLength":1}},
        "scope":{"type":"object"},
        "envelope":{"type":"object"},
        "independent_gate_signer":{"type":"string","minLength":1},
        "effective_version":{"type":"string","minLength":1},
        "rollback_target":{"type":"string","minLength":1},
        "verdict":{"enum":["PROMOTE","REJECT","HOLD"]}
      }
    },
    "JobRecord":{
      "type":"object","additionalProperties":false,
      "required":["job_id","kind","input_hashes","dedupe_key","state","generation","attempt","resource_budget","output_refs"],
      "properties":{
        "job_id":{"$ref":"common.schema.json#/$defs/Id"},
        "kind":{"type":"string","minLength":1},
        "input_hashes":{"type":"array","items":{"$ref":"common.schema.json#/$defs/Digest"}},
        "dedupe_key":{"type":"string","minLength":1},
        "state":{"enum":["QUEUED","RUNNING","WAITING_EXTERNAL","SUCCEEDED","FAILED","CANCELLED"]},
        "owner":{"type":"string","minLength":1},
        "lease_until":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "generation":{"$ref":"common.schema.json#/$defs/Sequence"},
        "attempt":{"type":"integer","minimum":0},
        "checkpoint_ref":{"type":"string","minLength":1},
        "resource_budget":{"type":"object"},
        "output_refs":{"type":"array","items":{"type":"string","minLength":1}},
        "error":{"type":"object"}
      }
    },
    "GateProfile":{
      "type":"object","additionalProperties":false,
      "required":["profile_id","version","registered_at","primary_metric","direction","baseline","minimum_practical_effect","uncertainty_method","confidence_level","selection_correction","power_or_precision_plan","risk_limits","retention_limits","cost_model_ref","stopping_rule","required_regime_coverage","digest"],
      "properties":{
        "profile_id":{"$ref":"common.schema.json#/$defs/Id"},
        "version":{"$ref":"common.schema.json#/$defs/Sequence"},
        "registered_at":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "primary_metric":{"type":"string","minLength":1},
        "direction":{"enum":["MAXIMIZE","MINIMIZE"]},
        "baseline":{"type":"string","minLength":1},
        "minimum_practical_effect":{"type":"number"},
        "uncertainty_method":{"type":"string","minLength":1},
        "confidence_level":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},
        "selection_correction":{"type":"string","minLength":1},
        "power_or_precision_plan":{"type":"object"},
        "risk_limits":{"type":"object"},
        "retention_limits":{"type":"object"},
        "cost_model_ref":{"type":"string","minLength":1},
        "stopping_rule":{"type":"object"},
        "required_regime_coverage":{"type":"object"},
        "digest":{"$ref":"common.schema.json#/$defs/Digest"}
      }
    }
  }
}
