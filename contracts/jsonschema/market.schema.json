{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autotrade.local/1.0.0/market.schema.json",
  "title": "AutoTrade market/instrument contracts",
  "$defs": {
    "CapabilitySnapshot": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "provider_id", "account_id", "entity_id", "environment", "observed_at", "expires_at", "supported_order_types", "time_in_force", "permission_scopes", "position_mode", "native_protection", "rate_limit_policy_id", "data_entitlements", "evidence", "status"], "properties": {"snapshot_id": {"$ref": "common.schema.json#/$defs/Id"}, "provider_id": {"type": "string", "minLength": 1}, "account_id": {"type": "string", "minLength": 1}, "entity_id": {"type": "string", "minLength": 1}, "environment": {"$ref": "common.schema.json#/$defs/Environment"}, "instrument_version": {"type": "string", "minLength": 1}, "observed_at": {"$ref": "common.schema.json#/$defs/UtcInstant"}, "expires_at": {"$ref": "common.schema.json#/$defs/UtcInstant"}, "supported_order_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "time_in_force": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "permission_scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "position_mode": {"type": "string", "minLength": 1}, "leverage_bounds": {"type": "object"}, "shorting_rules": {"type": "object"}, "reduce_only_semantics": {"type": "object"}, "native_protection": {"type": "array", "items": {"type": "string", "minLength": 1}}, "rate_limit_policy_id": {"type": "string", "minLength": 1}, "data_entitlements": {"type": "array", "items": {"type": "string", "minLength": 1}}, "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/EvidenceRef"}}, "status": {"enum": ["VERIFIED", "UNKNOWN", "CONFLICTED", "EXPIRED"]}}},
    "MarketEvent": {"type": "object", "additionalProperties": false, "required": ["event_id", "instrument_version", "kind", "source_event_at", "available_at", "availability_basis", "ingested_at", "revision", "payload", "quality_flags", "raw_evidence_ref"], "properties": {"event_id": {"$ref": "common.schema.json#/$defs/Id"}, "instrument_version": {"type": "string", "minLength": 1}, "kind": {"enum": ["TRADE", "QUOTE", "BOOK_SNAPSHOT", "BOOK_DELTA", "BAR", "FUNDING", "MARK", "INDEX", "STATUS"]}, "source_event_at": {"$ref": "common.schema.json#/$defs/UtcInstant"}, "available_at": {"$ref": "common.schema.json#/$defs/UtcInstant"}, "availability_basis": {"type": "string", "minLength": 1}, "ingested_at": {"$ref": "common.schema.json#/$defs/UtcInstant"}, "source_sequence": {"$ref": "common.schema.json#/$defs/Sequence"}, "revision": {"$ref": "common.schema.json#/$defs/Sequence"}, "payload": {"type": "object"}, "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "raw_evidence_ref": {"$ref": "common.schema.json#/$defs/EvidenceRef"}}}
  }
}
