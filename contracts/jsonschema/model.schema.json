{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autotrade.local/1.0.0/model.schema.json",
  "title": "AutoTrade model gateway contracts",
  "$defs": {
    "PrivacyClass": {"enum": ["PUBLIC", "PRIVATE", "SENSITIVE"]},
    "ProviderKind": {"enum": ["NO_LLM", "LOCAL", "CLOUD"]},
    "ModelFailureEffect": {"enum": ["UNKNOWN", "NO_EFFECT"]},
    "ModelResourcePolicy": {"type": "object", "additionalProperties": false, "properties": {"max_cpu_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}, "max_memory_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}, "min_available_memory_bytes": {"type": "integer", "minimum": 1}}},
    "ModelDownloadAuthorization": {"type": "object", "additionalProperties": false, "required": ["authorization_id", "provider_id", "model", "license_reference"], "properties": {"authorization_id": {"$ref": "common.schema.json#/$defs/Id"}, "provider_id": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "license_reference": {"type": "string", "minLength": 1}, "expected_model_id": {"type": "string", "minLength": 1}, "expires_at": {"$ref": "common.schema.json#/$defs/UtcInstant"}}},
    "ProviderCapabilities": {"type": "object", "additionalProperties": false, "required": ["provider_id", "kind", "supports_private_data", "supports_tools", "supports_streaming", "supports_hard_cancellation"], "properties": {"provider_id": {"type": "string", "minLength": 1}, "kind": {"$ref": "#/$defs/ProviderKind"}, "supports_private_data": {"type": "boolean"}, "supports_tools": {"type": "boolean"}, "supports_streaming": {"type": "boolean"}, "supports_hard_cancellation": {"const": false, "description": "Fail-closed default schema. A provider-specific qualified extension may explicitly opt in after evidence."}}},
    "ModelRequest": {"type": "object", "additionalProperties": false, "required": ["request_id", "role", "task_schema", "data_classification", "allowed_model_ids", "privacy", "budget_reservation", "deadline", "evidence_refs", "allowed_tools"], "properties": {"request_id": {"$ref": "common.schema.json#/$defs/Id"}, "role": {"type": "string", "minLength": 1}, "task_schema": {"type": "string", "minLength": 1}, "data_classification": {"type": "string", "minLength": 1}, "allowed_model_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "privacy": {"$ref": "#/$defs/PrivacyClass"}, "budget_reservation": {"$ref": "common.schema.json#/$defs/Money"}, "deadline": {"$ref": "common.schema.json#/$defs/UtcInstant"}, "evidence_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/EvidenceRef"}}, "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "resource_policy": {"$ref": "#/$defs/ModelResourcePolicy"}}},
    "ModelResponse": {"type": "object", "additionalProperties": false, "required": ["request_id", "provider_id", "provider_kind", "model", "result", "validation_verdict", "usage", "latency_ms"], "properties": {"request_id": {"$ref": "common.schema.json#/$defs/Id"}, "provider_id": {"type": "string", "minLength": 1}, "provider_kind": {"$ref": "#/$defs/ProviderKind"}, "model": {"type": "string", "minLength": 1}, "model_revision": {"type": ["string", "null"]}, "result": {}, "validation_verdict": {"enum": ["VALID", "INVALID", "REFUSED", "FALLBACK", "ERROR"]}, "usage": {"type": "object", "additionalProperties": false, "properties": {"input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "total_tokens": {"type": ["integer", "null"], "minimum": 0}}}, "measured_cost": {"$ref": "common.schema.json#/$defs/Money"}, "latency_ms": {"type": "number", "minimum": 0}, "failure_effect": {"$ref": "#/$defs/ModelFailureEffect"}, "error_code": {"type": ["string", "null"]}}}
  }
}
