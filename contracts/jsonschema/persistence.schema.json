{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.autotrade.local/4.0.0/persistence.schema.json",
  "title":"AutoTrade persistence and reconciliation contracts",
  "$defs":{
    "JournalPosting":{
      "type":"object","additionalProperties":false,
      "required":["ledger_account","asset_or_currency","signed_amount"],
      "properties":{
        "ledger_account":{"type":"string","minLength":1},
        "asset_or_currency":{"type":"string","minLength":1},
        "signed_amount":{"$ref":"common.schema.json#/$defs/Decimal"},
        "valuation_ref":{"type":"string","minLength":1}
      }
    },
    "JournalTransaction":{
      "type":"object","additionalProperties":false,
      "required":["transaction_id","cause_event_id","booking_date","effective_date","postings","evidence"],
      "properties":{
        "transaction_id":{"$ref":"common.schema.json#/$defs/Id"},
        "cause_event_id":{"$ref":"common.schema.json#/$defs/Id"},
        "booking_date":{"type":"string","format":"date"},
        "effective_date":{"type":"string","format":"date"},
        "postings":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/JournalPosting"}},
        "reverses_transaction_id":{"$ref":"common.schema.json#/$defs/Id"},
        "evidence":{"type":"array","items":{"$ref":"common.schema.json#/$defs/EvidenceRef"}}
      }
    },
    "ReconciliationDifference":{
      "type":"object","additionalProperties":false,
      "required":["kind","local_ref","provider_ref","status"],
      "properties":{
        "kind":{"type":"string","minLength":1},
        "local_ref":{"type":["string","null"]},
        "provider_ref":{"type":["string","null"]},
        "amount":{"$ref":"common.schema.json#/$defs/Money"},
        "status":{"enum":["MATCHED","LOCAL_ONLY","PROVIDER_ONLY","VALUE_MISMATCH","INCONCLUSIVE"]}
      }
    },
    "ReconciliationRun":{
      "type":"object","additionalProperties":false,
      "required":["run_id","scope","opening_local_version","provider_watermarks","inspected_windows","matched_items","unmatched_items","differences","actions","closing_version","verdict"],
      "properties":{
        "run_id":{"$ref":"common.schema.json#/$defs/Id"},
        "scope":{"type":"object"},
        "opening_local_version":{"$ref":"common.schema.json#/$defs/Sequence"},
        "provider_watermarks":{"type":"object"},
        "inspected_windows":{"type":"array","items":{"type":"object"}},
        "matched_items":{"type":"array","items":{"type":"string","minLength":1}},
        "unmatched_items":{"type":"array","items":{"type":"string","minLength":1}},
        "differences":{"type":"array","items":{"$ref":"#/$defs/ReconciliationDifference"}},
        "actions":{"type":"array","items":{"type":"string","minLength":1}},
        "closing_version":{"$ref":"common.schema.json#/$defs/Sequence"},
        "verdict":{"enum":["CONSISTENT","CORRECTED","INCONCLUSIVE","BLOCKED"]}
      }
    }
  }
}
