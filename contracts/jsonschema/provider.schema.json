{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.autotrade.local/4.0.0/provider.schema.json",
  "title":"AutoTrade provider interface result contracts",
  "$defs":{
    "Balance":{
      "type":"object","additionalProperties":false,
      "required":["currency","total","available","as_of"],
      "properties":{
        "currency":{"$ref":"common.schema.json#/$defs/CurrencyId"},
        "total":{"$ref":"common.schema.json#/$defs/Decimal"},
        "settled":{"$ref":"common.schema.json#/$defs/Decimal"},
        "unsettled":{"$ref":"common.schema.json#/$defs/Decimal"},
        "available":{"$ref":"common.schema.json#/$defs/Decimal"},
        "reserved":{"$ref":"common.schema.json#/$defs/Decimal"},
        "liability":{"$ref":"common.schema.json#/$defs/Decimal"},
        "as_of":{"$ref":"common.schema.json#/$defs/UtcInstant"}
      }
    },
    "Position":{
      "type":"object","additionalProperties":false,
      "required":["instrument_version","position_side","quantity","source","as_of"],
      "properties":{
        "instrument_version":{"type":"string","minLength":1},
        "position_side":{"enum":["NET","LONG","SHORT"]},
        "quantity":{"$ref":"common.schema.json#/$defs/Quantity"},
        "average_cost":{"$ref":"common.schema.json#/$defs/Decimal"},
        "mark_price":{"$ref":"common.schema.json#/$defs/Decimal"},
        "realized_pnl":{"$ref":"common.schema.json#/$defs/Money"},
        "unrealized_pnl":{"$ref":"common.schema.json#/$defs/Money"},
        "collateral":{"$ref":"common.schema.json#/$defs/Money"},
        "source":{"type":"string","minLength":1},
        "as_of":{"$ref":"common.schema.json#/$defs/UtcInstant"}
      }
    },
    "MarginSnapshot":{
      "type":"object","additionalProperties":false,
      "required":["account_id","as_of","model_id","source","quality"],
      "properties":{
        "account_id":{"type":"string","minLength":1},
        "as_of":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "initial_requirement":{"$ref":"common.schema.json#/$defs/Money"},
        "maintenance_requirement":{"$ref":"common.schema.json#/$defs/Money"},
        "available_collateral":{"$ref":"common.schema.json#/$defs/Money"},
        "liquidation_estimate":{"$ref":"common.schema.json#/$defs/Money"},
        "model_id":{"type":"string","minLength":1},
        "source":{"type":"string","minLength":1},
        "quality":{"type":"string","minLength":1}
      }
    },
    "AccountSnapshot":{
      "type":"object","additionalProperties":false,
      "required":["snapshot_id","account_id","environment","query_started_at","query_completed_at","consistency","balances","positions","open_orders","margin","evidence"],
      "properties":{
        "snapshot_id":{"$ref":"common.schema.json#/$defs/Id"},
        "account_id":{"type":"string","minLength":1},
        "environment":{"$ref":"common.schema.json#/$defs/Environment"},
        "query_started_at":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "query_completed_at":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "provider_as_of":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "stream_watermark":{"type":"string","minLength":1},
        "consistency":{"enum":["ATOMIC","RECONSTRUCTED","PARTIAL"]},
        "balances":{"type":"array","items":{"$ref":"#/$defs/Balance"}},
        "positions":{"type":"array","items":{"$ref":"#/$defs/Position"}},
        "open_orders":{"type":"array","items":{"type":"object"}},
        "margin":{"$ref":"#/$defs/MarginSnapshot"},
        "evidence":{"type":"array","items":{"$ref":"common.schema.json#/$defs/EvidenceRef"}}
      }
    },
    "SubmissionResult":{
      "type":"object","additionalProperties":false,
      "required":["attempt_id","outcome","client_order_id","evidence","retry_disposition"],
      "properties":{
        "attempt_id":{"$ref":"common.schema.json#/$defs/Id"},
        "outcome":{"enum":["ACKNOWLEDGED","REJECTED","UNKNOWN"]},
        "provider_order_id":{"type":"string","minLength":1},
        "client_order_id":{"type":"string","minLength":1},
        "provider_received_at":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "reason_code":{"type":"string","minLength":1},
        "evidence":{"type":"array","items":{"$ref":"common.schema.json#/$defs/EvidenceRef"}},
        "retry_disposition":{"enum":["NEVER","RECONCILE_FIRST","NEW_ADMISSION_REQUIRED"]}
      }
    },
    "QueryOrderResult":{
      "type":"object","additionalProperties":false,
      "required":["verdict","searched_surfaces","time_window","pagination_complete","consistency_horizon","evidence"],
      "properties":{
        "verdict":{"enum":["FOUND","PROVEN_ABSENT","INCONCLUSIVE"]},
        "order":{"type":"object"},
        "searched_surfaces":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "time_window":{"type":"object"},
        "pagination_complete":{"type":"boolean"},
        "consistency_horizon":{"type":"string","minLength":1},
        "evidence":{"type":"array","items":{"$ref":"common.schema.json#/$defs/EvidenceRef"}}
      }
    },
    "HealthResult":{
      "type":"object","additionalProperties":false,
      "required":["component","as_of","status","affected_scope","reason_codes"],
      "properties":{
        "component":{"type":"string","minLength":1},
        "as_of":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "status":{"enum":["READY","RECOVERING","DEGRADED","BLOCKED","STOPPED"]},
        "affected_scope":{"type":"array","items":{"type":"string","minLength":1}},
        "reason_codes":{"type":"array","items":{"type":"string","minLength":1}},
        "last_good_at":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "next_action":{"type":"string","minLength":1}
      }
    }
  }
}
