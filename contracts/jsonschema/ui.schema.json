{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autotrade.local/3.0.1/ui.schema.json",
  "title": "AutoTrade host/UI contracts",
  "$defs": {
    "UiSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_version",
        "event_cursor",
        "server_time",
        "host_id",
        "account_id",
        "environment",
        "permission_summary",
        "connection_freshness",
        "portfolio",
        "risk",
        "strategy",
        "jobs",
        "reason_codes"
      ],
      "properties": {
        "state_version": {
          "$ref": "common.schema.json#/$defs/Sequence"
        },
        "event_cursor": {
          "type": "string",
          "minLength": 1
        },
        "server_time": {
          "$ref": "common.schema.json#/$defs/UtcInstant"
        },
        "host_id": {
          "type": "string",
          "minLength": 1
        },
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "$ref": "common.schema.json#/$defs/Environment"
        },
        "permission_summary": {
          "$ref": "#/$defs/PermissionSummary"
        },
        "connection_freshness": {
          "type": "object"
        },
        "portfolio": {
          "type": "object"
        },
        "risk": {
          "type": "object"
        },
        "strategy": {
          "type": "object"
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "UiCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "expected_state_version",
        "idempotency_key",
        "actor",
        "session",
        "account_id",
        "environment",
        "action",
        "payload"
      ],
      "properties": {
        "command_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "expected_state_version": {
          "$ref": "common.schema.json#/$defs/Sequence"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "$ref": "#/$defs/SessionReference"
        },
        "action": {
          "type": "string",
          "enum": [
            "BLOCK_NEW_EXPOSURE",
            "REVOKE_AUTHORITY",
            "SET_AUTHORITY"
          ]
        },
        "payload": {
          "type": "object"
        },
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "$ref": "common.schema.json#/$defs/Environment"
        }
      }
    },
    "CommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "status",
        "state_version",
        "reason_codes",
        "field_errors"
      ],
      "properties": {
        "command_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "operation_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "status": {
          "enum": [
            "ACCEPTED",
            "REJECTED",
            "CONFLICT"
          ]
        },
        "state_version": {
          "$ref": "common.schema.json#/$defs/Sequence"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "field_errors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "current_value_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "OperationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "phase",
        "started_at",
        "updated_at",
        "affected_refs",
        "evidence",
        "remaining_uncertainty"
      ],
      "properties": {
        "operation_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "phase": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "WAITING_EXTERNAL",
            "SUCCEEDED",
            "FAILED",
            "UNKNOWN",
            "CANCELLED"
          ]
        },
        "started_at": {
          "$ref": "common.schema.json#/$defs/UtcInstant"
        },
        "updated_at": {
          "$ref": "common.schema.json#/$defs/UtcInstant"
        },
        "affected_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/EvidenceRef"
          }
        },
        "remaining_uncertainty": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "SessionReference": {
      "type": "string",
      "pattern": "^sid-[0-9a-f]{64}$",
      "description": "Public one-way session reference. This is never the reusable bearer credential."
    },
    "PermissionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "session",
        "role"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "$ref": "#/$defs/SessionReference"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
