{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.autotrade.local/1.0.0/ui.schema.json",
  "title":"AutoTrade host/UI contracts",
  "$defs":{
    "UiSnapshot":{
      "type":"object","additionalProperties":false,
      "required":["state_version","event_cursor","server_time","host_id","account_id","environment","permission_summary","connection_freshness","portfolio","risk","strategy","jobs","reason_codes"],
      "properties":{
        "state_version":{"$ref":"common.schema.json#/$defs/Sequence"},
        "event_cursor":{"type":"string","minLength":1},
        "server_time":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "host_id":{"type":"string","minLength":1},
        "account_id":{"type":"string","minLength":1},
        "environment":{"$ref":"common.schema.json#/$defs/Environment"},
        "permission_summary":{"type":"object"},
        "connection_freshness":{"type":"object"},
        "portfolio":{"type":"object"},
        "risk":{"type":"object"},
        "strategy":{"type":"object"},
        "jobs":{"type":"array","items":{"type":"object"}},
        "reason_codes":{"type":"array","items":{"type":"string","minLength":1}}
      }
    },
    "UiCommand":{
      "type":"object","additionalProperties":false,
      "required":["command_id","expected_state_version","idempotency_key","actor","session","action","payload"],
      "properties":{
        "command_id":{"$ref":"common.schema.json#/$defs/Id"},
        "expected_state_version":{"$ref":"common.schema.json#/$defs/Sequence"},
        "idempotency_key":{"type":"string","minLength":1,"maxLength":128},
        "actor":{"type":"string","minLength":1},
        "session":{"type":"string","minLength":1},
        "action":{"type":"string","minLength":1},
        "payload":{"type":"object"}
      }
    },
    "CommandResult":{
      "type":"object","additionalProperties":false,
      "required":["command_id","status","state_version","reason_codes","field_errors"],
      "properties":{
        "command_id":{"$ref":"common.schema.json#/$defs/Id"},
        "operation_id":{"$ref":"common.schema.json#/$defs/Id"},
        "status":{"enum":["ACCEPTED","REJECTED","CONFLICT"]},
        "state_version":{"$ref":"common.schema.json#/$defs/Sequence"},
        "reason_codes":{"type":"array","items":{"type":"string","minLength":1}},
        "field_errors":{"type":"array","items":{"type":"object"}},
        "current_value_ref":{"type":"string","minLength":1}
      }
    },
    "OperationResult":{
      "type":"object","additionalProperties":false,
      "required":["operation_id","phase","started_at","updated_at","affected_refs","evidence","remaining_uncertainty"],
      "properties":{
        "operation_id":{"$ref":"common.schema.json#/$defs/Id"},
        "phase":{"enum":["QUEUED","RUNNING","WAITING_EXTERNAL","SUCCEEDED","FAILED","UNKNOWN","CANCELLED"]},
        "started_at":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "updated_at":{"$ref":"common.schema.json#/$defs/UtcInstant"},
        "affected_refs":{"type":"array","items":{"type":"string","minLength":1}},
        "evidence":{"type":"array","items":{"$ref":"common.schema.json#/$defs/EvidenceRef"}},
        "remaining_uncertainty":{"type":"array","items":{"type":"string","minLength":1}}
      }
    }
  }
}
