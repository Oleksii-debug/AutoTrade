{
  "schema": "autotrade-process-watchdog-manifest-v1",
  "processes": [
    {
      "id": "whitebit-public-sol",
      "script": "tools/run_whitebit_public_supervisor.py",
      "args": [
        "--market", "SOL_USDT",
        "--state-dir", "${RUNTIME_ROOT}/whitebit-public-sol-v1-20261111",
        "--checkpoint-seconds", "15",
        "--max-artifacts", "4096",
        "--stop-file", "${RUNTIME_ROOT}/whitebit-public-sol-v1-20261111/managed.stop.json"
      ],
      "stop_file": "${RUNTIME_ROOT}/whitebit-public-sol-v1-20261111/managed.stop.json",
      "checkpoint": "${RUNTIME_ROOT}/whitebit-public-sol-v1-20261111/supervisor-state.json",
      "restart_limit": 5,
      "restart_window_seconds": 300,
      "backoff_seconds": 2
    },
    {
      "id": "whitebit-public-futures-trade-tape",
      "script": "tools/run_whitebit_public_trade_tape.py",
      "args": [
        "--state-dir", "${RUNTIME_ROOT}/whitebit-public-futures-trade-tape-v1-20261112",
        "--market", "BTC_PERP",
        "--market", "ETH_PERP",
        "--market", "SOL_PERP",
        "--market", "NEAR_PERP",
        "--market", "SUI_PERP",
        "--exact-print-market", "BTC_PERP",
        "--exact-print-market", "ETH_PERP",
        "--poll-seconds", "1",
        "--bucket-seconds", "5",
        "--retention-days", "14",
        "--stop-file", "${RUNTIME_ROOT}/whitebit-public-futures-trade-tape-v1-20261112/managed.stop.json"
      ],
      "stop_file": "${RUNTIME_ROOT}/whitebit-public-futures-trade-tape-v1-20261112/managed.stop.json",
      "checkpoint": "${RUNTIME_ROOT}/whitebit-public-futures-trade-tape-v1-20261112/checkpoint.json",
      "restart_limit": 5,
      "restart_window_seconds": 300,
      "backoff_seconds": 2
    },
    {
      "id": "whitebit-course-research",
      "script": "tools/run_whitebit_course_supervisor.py",
      "args": [
        "--state-dir", "${RUNTIME_ROOT}/whitebit-course-research-v1-20261112",
        "--bars", "20000",
        "--interval-seconds", "21600",
        "--max-cycles-per-utc-day", "4",
        "--defer-on-battery",
        "--stop-file", "${RUNTIME_ROOT}/whitebit-course-research-v1-20261112/managed.stop.json"
      ],
      "stop_file": "${RUNTIME_ROOT}/whitebit-course-research-v1-20261112/managed.stop.json",
      "checkpoint": "${RUNTIME_ROOT}/whitebit-course-research-v1-20261112/checkpoint.json",
      "restart_limit": 5,
      "restart_window_seconds": 300,
      "backoff_seconds": 2
    },
    {
      "id": "whitebit-depth-tape",
      "script": "tools/run_whitebit_depth_tape.py",
      "args": [
        "--state-dir", "${RUNTIME_ROOT}/whitebit-depth-tape-v1-20261112",
        "--market", "BTC_PERP",
        "--market", "ETH_PERP",
        "--market", "SOL_PERP",
        "--market", "NEAR_PERP",
        "--market", "SUI_PERP",
        "--poll-seconds", "1",
        "--bucket-seconds", "1",
        "--retention-days", "3",
        "--depth-limit", "20",
        "--stop-file", "${RUNTIME_ROOT}/whitebit-depth-tape-v1-20261112/managed.stop.json"
      ],
      "stop_file": "${RUNTIME_ROOT}/whitebit-depth-tape-v1-20261112/managed.stop.json",
      "checkpoint": "${RUNTIME_ROOT}/whitebit-depth-tape-v1-20261112/checkpoint.json",
      "restart_limit": 5,
      "restart_window_seconds": 300,
      "backoff_seconds": 2
    },
    {
      "id": "whitebit-subhour-screen",
      "script": "tools/run_whitebit_subhour_supervisor.py",
      "args": [
        "--state-dir", "${RUNTIME_ROOT}/whitebit-subhour-screen-v1-20261112",
        "--bars", "6000",
        "--interval-seconds", "21600",
        "--defer-on-battery",
        "--stop-file", "${RUNTIME_ROOT}/whitebit-subhour-screen-v1-20261112/managed.stop.json"
      ],
      "stop_file": "${RUNTIME_ROOT}/whitebit-subhour-screen-v1-20261112/managed.stop.json",
      "checkpoint": "${RUNTIME_ROOT}/whitebit-subhour-screen-v1-20261112/checkpoint.json",
      "restart_limit": 5,
      "restart_window_seconds": 300,
      "backoff_seconds": 2
    },
    {
      "id": "whitebit-subhour-forward-shadow",
      "script": "tools/run_whitebit_subhour_forward_shadow.py",
      "args": [
        "--state-dir", "${RUNTIME_ROOT}/whitebit-subhour-forward-v1-20261112",
        "--depth-database", "${RUNTIME_ROOT}/whitebit-depth-tape-v1-20261112/depth-tape.sqlite3",
        "--poll-seconds", "30",
        "--stop-file", "${RUNTIME_ROOT}/whitebit-subhour-forward-v1-20261112/managed.stop.json"
      ],
      "stop_file": "${RUNTIME_ROOT}/whitebit-subhour-forward-v1-20261112/managed.stop.json",
      "checkpoint": "${RUNTIME_ROOT}/whitebit-subhour-forward-v1-20261112/checkpoint.json",
      "restart_limit": 5,
      "restart_window_seconds": 300,
      "backoff_seconds": 2
    }
  ]
}
