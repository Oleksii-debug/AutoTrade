<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Keep RID-less and -r win-x64 locked restores on one declared NuGet graph. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>AutoTrade.Contracts</AssemblyName>
    <RootNamespace>AutoTrade.Contracts</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../contracts/jsonschema/**/*.json"
          Link="Schemas/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
